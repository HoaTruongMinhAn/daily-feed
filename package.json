{
  "name": "daily-feed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test",
    "fetch": "node scripts/fetch.mjs",
    "merge": "node scripts/merge.mjs",
    "build": "node scripts/build.mjs",
    "feed": "bash scripts/daily-feed-run.sh --now",
    "feed:stub": "bash scripts/daily-feed-run.sh --now --stub",
    "feed:detail": "bash scripts/daily-feed-run.sh --now --detail-only",
    "feed:backfill": "bash scripts/daily-feed-run.sh --now --detail-only --backfill",
    "serve": "python3 -m http.server 8080 -d site"
  }
}
